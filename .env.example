# --- LLM ---
# Get a key at https://aistudio.google.com/apikey  (free tier is fine)
GOOGLE_API_KEY=
QG_MODEL=gemini-3.6-flash
QG_TEMPERATURE=0.0

# --- Databases ---
# SQLite is the default target and the only one BIRD supports.
QG_SQLITE_DIR=data/db

# Postgres (docker compose up -d). The app connects as the READ-ONLY role.
QG_PG_DSN=postgresql://queryguard_ro:readonly@localhost:5433/queryguard
# Admin DSN is used only by the data loader script, never by the agent.
QG_PG_ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/queryguard

# --- Safety limits ---
QG_MAX_ROWS=200
QG_QUERY_TIMEOUT_S=10
QG_MAX_REPAIR_ATTEMPTS=3

# --- Reproducibility ---
QG_SEED=20260918
QG_LLM_CACHE=1
